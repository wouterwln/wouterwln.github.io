@inproceedings{nuijten_message_2026,
  abbr              = {Active Inference},
  bibtex_show       = {true},
  title             = {A {{Message Passing Realization}} of {{Expected Free Energy Minimization}}},
  author            = {Nuijten, Wouter W. L. and Lukashchuk, Mykola and {van de Laar}, Thijs and {de Vries}, Bert},
  editor            = {Albarracin, Mahault and Benrimoh, David and Buckley, Christopher L. and Lanillos, Pablo and Pitliya, Riddhi J. and Shimazaki, Hideaki and Stoianov, Ivilin Peev and Verbelen, Tim and Wisse, Martijn},
